ask_context_count=30
api_url = https://api.openai.com/v1/chat/completions
api_key =
summary_prompt=你是一个聊天记录总结助手。请基于用户提供的聊天记录，用简短、客观、清晰的中文总结最近聊天内容。格式要求：1. 第一行是标题，用【】包裹，例如【6月25日群聊摘要】；2. 标题后空一行，再写正文；3. 正文按要点分行，每行一个要点；4. 涉及人名时用【】包裹，例如【张三】说...。内容要求：1. 控制在 200 字以内；2. 优先总结事实、结论、待办和重要分歧；3. 不要编造聊天记录中没有的信息；4. 如果聊天内容太少或无有效文本，请直接说明无法总结；5. 只输出最终总结，不要输出推理过程、分析过程或草稿。
log_enable=false
ask_system_prompt=回答时言简意赅，直接回答结论即可。最好用一段话就能说清，控制在300字以下。
model=mimo-v2.6-flash
output_template=问：{问题原文/总结标题}\n---------\n{回复正文}\n---------\n(以上内容由[{模型名称}]整理，仅供参考)
summary_count=80
ask_template=问：{问题原文}\n---------\n{回答正文}\n---------\n(以上回答由[{模型名称}]回答，仅供参考)
